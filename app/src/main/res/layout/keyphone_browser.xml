<?xml version="1.0" encoding="utf-8"?>
<!--
    按键机浏览页内容布局（UC 风格）。

    顶部：UC 风格横向标签栏（展示主页及所有打开的 Web 标签页，按 0 循环切换）；
    其下：地址栏容器（浏览网页时展示）与 2dp 加载进度线；
    内容区：包含主页 ScrollView 与 WebView 宿主 FrameLayout，以及按键 * 弹出的数字快捷菜单浮层。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyphone_browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- UC 风格顶部标签栏：横向滚动展示全部标签页及主页 -->
    <HorizontalScrollView
        android:id="@+id/keyphone_tab_bar_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true"
        android:background="#121D2C"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <LinearLayout
            android:id="@+id/keyphone_tab_bar_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </HorizontalScrollView>

    <!-- 顶栏地址栏容器（在浏览网页时展示，在主页时隐藏） -->
    <LinearLayout
        android:id="@+id/keyphone_address_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="#1B2B40"
        android:visibility="gone" />

    <!-- 顶栏页内查找控制条（在进入查找模式时展示） -->
    <LinearLayout
        android:id="@+id/keyphone_find_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="#1B2B40"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/keyphone_find_query_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/keyphone_find_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F39800"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2dp 加载进度线（按百分比横向拉伸，idle 时 INVISIBLE） -->
    <View
        android:id="@+id/keyphone_progress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/keydroidx_bottom_text"
        android:visibility="invisible" />

    <!-- 主内容区：主页、Web 页面宿主与快捷菜单浮层 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 主页视图容器 -->
        <ScrollView
            android:id="@+id/keyphone_home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/keyphone_home_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />
        </ScrollView>

        <!-- Web 浏览器容器（WebView 挂在里面） -->
        <FrameLayout
            android:id="@+id/keyphone_browser_frame_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
